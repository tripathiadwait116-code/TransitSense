# Telangana Smart RTC — Environment Variables

# PostgreSQL Database Connection String (Neon, Supabase, AWS RDS, or local PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/telangana_smart_rtc?schema=public"

# Authentication JWT Secret (min 32 characters)
AUTH_SECRET="telangana-smart-rtc-secure-jwt-auth-secret-key-2026-prod"

# Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional Mapbox/Tile API Key (If omitted, system uses free OpenStreetMap tiles automatically)
NEXT_PUBLIC_MAP_API_KEY=""
MAP_API_SECRET=""
